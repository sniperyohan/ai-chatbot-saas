{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-chatbot-saas",
  "compatibility_date": "2026-03-29",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ]
  // 환경변수는 Cloudflare Dashboard > Pages > Settings > Environment Variables 에서 설정
  // 또는 wrangler secret put 명령어로 설정:
  // npx wrangler pages secret put GEMINI_API_KEY --project-name ai-chatbot-saas
  // npx wrangler pages secret put SUPABASE_URL --project-name ai-chatbot-saas
  // npx wrangler pages secret put SUPABASE_ANON_KEY --project-name ai-chatbot-saas
  // npx wrangler pages secret put SUPABASE_SERVICE_KEY --project-name ai-chatbot-saas
  // npx wrangler pages secret put SUPER_JWT_SECRET --project-name ai-chatbot-saas
  // npx wrangler pages secret put ADMIN_JWT_SECRET --project-name ai-chatbot-saas
  // npx wrangler pages secret put RESEND_API_KEY --project-name ai-chatbot-saas
  // npx wrangler pages secret put ENCRYPTION_KEY --project-name ai-chatbot-saas
  // npx wrangler pages secret put ALLOWED_ORIGINS --project-name ai-chatbot-saas
}
