{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-chatbot-saas",
  "main": "./dist/index.js",
  "compatibility_date": "2026-03-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Workers Static Assets - admin SPA, widget, 정적 파일 서빙
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS"
  }
  // ─────────────────────────────────────────────────────────────
  // 환경변수는 Cloudflare Dashboard > Workers > Settings > Variables
  // 또는 wrangler secret put 명령어로 설정:
  //   npx wrangler secret put GEMINI_API_KEY
  //   npx wrangler secret put SUPABASE_URL
  //   npx wrangler secret put SUPABASE_ANON_KEY
  //   npx wrangler secret put SUPABASE_SERVICE_KEY
  //   npx wrangler secret put SUPER_JWT_SECRET
  //   npx wrangler secret put ADMIN_JWT_SECRET
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put ENCRYPTION_KEY
  //   npx wrangler secret put ALLOWED_ORIGINS
  //
  // Supabase Integration (Cloudflare Dashboard > Workers > Integrations):
  //   연결 시 SUPABASE_URL, SUPABASE_ANON_KEY 자동 바인딩
  // ─────────────────────────────────────────────────────────────
}
